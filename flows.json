    {
        "id": "store_sequence_mode",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "Store Sequence Mode",
        "func": "const allowed = ['timed', 'event'];\nconst mode = String(msg.payload || '').trim().toLowerCase();\n\nif (!allowed.includes(mode)) {\n    node.warn(\"Invalid sequence mode: \" + msg.payload);\n    return null;\n}\n\nflow.set('sequencerMode', mode);\nflow.set('lastSlotKey', null);\nflow.set('wsjtxTransmitting', null);\nflow.set('wsjtxBandFrequency', null);\nnode.status({fill:\"green\", shape:\"dot\", text:\"Sequence=\" + mode});\nreturn {payload:\"sequencer mode set to \" + mode};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
