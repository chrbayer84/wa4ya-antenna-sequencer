    {
        "id": "sequencer_clock",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "Sequencer Clock",
        "func": "if (flow.get('sequencerMode') === 'event') {\n    return null;\n}\n\nconst interval = Number(flow.get('switchInterval') || 15);\nconst slot = Math.floor((Date.now() / 1000 + 1) / interval);\nconst key = interval + ':' + slot;\n\nif (flow.get('lastSlotKey') === key) {\n    return null;\n}\n\nflow.set('lastSlotKey', key);\nreturn {payload: 'slot', slot: slot, interval: interval};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "flow.set('lastSlotKey', null);",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 40,
        "wires": [
            [
                "sequencer_function"
            ]
        ]
    },
