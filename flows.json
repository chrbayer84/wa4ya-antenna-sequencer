    {
        "id": "sequencer_function",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "Antenna Sequencer",
        "func": "function getAntenna(frequency) {\n  const antennas = [\n    { name: 'vertical', min: 1.8, max: 2.0 },\n    { name: 'vertical', min: 3.5, max: 4.0 },\n    { name: 'vertical', min: 5.3305, max: 5.405 }, // Center frequencies vary\n    { name: 'vertical', min: 7.0, max: 7.3 },\n    { name: 'deltaloop', min: 10.1, max: 10.15 },\n    { name: 'vertical', min: 14.0, max: 14.35 },\n    { name: 'vertical', min: 18.068, max: 18.168 },\n    { name: 'deltaloop', min: 21.0, max: 21.45 },\n    { name: 'deltaloop', min: 24.89, max: 24.99 },\n    { name: 'deltaloop', min: 28.0, max: 29.7 }\n  ];\n\n  const antenna = antennas.find(\n    b => Number(frequency)/1000000 >= b.min \n      && Number(frequency)/1000000 <= b.max);\n  return antenna ? antenna.name : 'deltaloop';\n}\n\n// msg.payload is 'slot', 'ptt', 'force', 'forceTX' or 'forceRX'\nconst sequenceMode = (flow.get('sequencerMode') || 'timed').toString();\nconst followBands = flow.get('followBands');\nconst frequency = (flow.get('frequency'));\nconst txMode = (flow.get('txMode') || 'even').toString();\nconst txA = (flow.get('txAntenna') || 'deltaloop').toString();\nconst rxA = (flow.get('rxAntenna') || 'deltaloop').toString();\nlet action = null;\nconst out = [];\n\n// Manual force always wins over automatic band following,\n// except in event mode where followBands is authoritative.\nif (msg.payload === 'force'){\n    if (sequenceMode === 'event' && followBands && frequency) {\n        out.push({payload:true, topic: getAntenna(frequency)});\n        return out;\n    }\n    out.push({payload:true, topic: txA});\n    out.push({payload:true, topic: rxA});\n    return out;\n}\nif (msg.payload === 'forceTX'){\n    const topic = (followBands && frequency) ? getAntenna(frequency) : txA;\n    out.push({payload:true, topic: topic});\n    return out;\n}\nif (msg.payload === 'forceRX'){\n    const topic = (followBands && frequency) ? getAntenna(frequency) : rxA;\n    out.push({payload:true, topic: topic});\n    return out;\n}\n\n// Follow-bands update from WSJT-X status messages\nif (msg.payload === 'band') {\n    const bandFrequency = (msg.frequency !== undefined) ? msg.frequency : frequency;\n    if (followBands && bandFrequency) {\n        out.push({payload:true, topic: getAntenna(bandFrequency)});\n    }\n    return out;\n}\n\n// Event (PTT) based sequencing\nif (sequenceMode === 'event' && msg.payload === 'ptt') {\n    const eventFrequency = (msg.frequency !== undefined) ? msg.frequency : frequency;\n    const antenna = (followBands && eventFrequency)\n        ? getAntenna(eventFrequency)\n        : (msg.transmitting ? txA : rxA);\n    out.push({payload:true, topic: antenna});\n    return out;\n}\n\n// Band following mode for timed sequencing and other non-PTT events\nif (followBands && frequency){\n    node.warn(\"frequency: \" + frequency);\n    node.warn(\"antenna: \" + getAntenna(frequency));\n    // set antenna based on band\n    out.push({payload:true, topic: getAntenna(frequency)});\n    // probably not needed\n    out.push({payload:true, topic: getAntenna(frequency)});\n    return out;\n}\n\n// Timed sequencing\nif (sequenceMode === 'timed' && msg.payload === 'slot') {\n    const isEvenSlot = (Number(msg.slot) % 2) === 0;\n    action = (isEvenSlot === (txMode === 'even')) ? 'toTX' : 'toRX';\n}\n\nif (action === 'toTX') {\n    out.push({payload:true, topic: txA});\n} else if (action === 'toRX') {\n    out.push({payload:true, topic: rxA});\n}\nreturn out;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
