    {
        "id": "wsjtx_ptt_events",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "WSJT-X PTT Events",
        "func": "if (msg.payload.type !== 'status') {\n    return null;\n}\n\nconst transmitting = msg.payload.transmitting === true;\nconst frequency = msg.payload.freqency;\nconst sequenceMode = (flow.get('sequencerMode') || 'timed').toString();\nconst followBands = flow.get('followBands');\n\nconst previousTransmitting = flow.get('wsjtxTransmitting');\nconst transmittingChanged = previousTransmitting === undefined\n    || previousTransmitting === null\n    || previousTransmitting !== transmitting;\nflow.set('wsjtxTransmitting', transmitting);\n\nif (sequenceMode !== 'event') {\n    return null;\n}\n\nif (followBands) {\n    const previousFrequency = flow.get('wsjtxBandFrequency');\n    const frequencyChanged = frequency !== undefined\n        && (previousFrequency === undefined || previousFrequency === null || previousFrequency !== frequency);\n    flow.set('wsjtxBandFrequency', frequency);\n\n    if (frequencyChanged) {\n        return {payload: 'band', frequency: frequency, mode: msg.payload.mode};\n    }\n    return null;\n}\n\nflow.set('wsjtxBandFrequency', null);\n\nif (!transmittingChanged) {\n    return null;\n}\n\nreturn {\n    payload: 'ptt',\n    transmitting: transmitting,\n    frequency: frequency,\n    mode: msg.payload.mode\n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
