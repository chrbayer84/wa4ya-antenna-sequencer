    {
        "id": "store_switch_interval",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "Store Switch Interval",
        "func": "const allowed = [7.5, 15, 30];\nconst interval = Number(msg.payload);\n\nif (!allowed.includes(interval)) {\n    node.warn(\"Invalid switch interval: \" + msg.payload);\n    return null;\n}\n\nflow.set('switchInterval', interval);\nflow.set('lastSlotKey', null);\nnode.status({fill:\"green\", shape:\"dot\", text:\"Interval=\" + interval + \"s\"});\nreturn {payload:\"switch interval set to \" + interval + \"s\"};",
