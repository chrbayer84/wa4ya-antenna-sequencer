    {
        "id": "404c1da5b635b298",
        "type": "function",
        "z": "d445d260.887a2",
        "name": "Extract WSJT-X Status",
        "func": "if (msg.payload.type === 'status') {\n    const mode = String(msg.payload.mode || '').trim().toUpperCase();\n    const modePeriods = { FT8: 15, FT4: 7.5 };\n    const period = modePeriods[mode];\n\n    flow.set('wsjtxMode', mode);\n    msg.mode = mode;\n    msg.payload = msg.payload.freqency;\n\n    if (period !== undefined && Number(flow.get('switchInterval')) !== period) {\n        flow.set('switchInterval', period);\n        flow.set('lastSlotKey', null);\n    }\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: \"mode=\" + (mode || \"?\") + (period !== undefined ? \" interval=\" + period + \"s\" : \" interval=manual\")\n    });\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
